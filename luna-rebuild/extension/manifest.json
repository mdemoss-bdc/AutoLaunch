{
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "bridge.js"
      ],
      "matches": [
        "https://mdemoss-bdc.github.io/AutoLaunch/*",
        "https://autolaunch.org/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "https://www.facebook.com/marketplace/create/vehicle*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "https://www.facebook.com/marketplace/you/selling*",
        "https://www.facebook.com/marketplace/you/dashboard*"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/messages/*",
        "https://www.facebook.com/marketplace/inbox*",
        "https://www.facebook.com/marketplace/*"
      ],
      "js": [
        "chat_capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Automated Facebook Marketplace helper for AutoLaunch users.",
  "externally_connectable": {
    "matches": [
      "https://mdemoss-bdc.github.io/*",
      "https://autolaunch.org/*"
    ]
  },
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://*.facebook.com/*",
    "https://mdemoss-bdc.github.io/*",
    "https://*/*"
  ],
  "manifest_version": 3,
  "name": "AutoLaunch Vehicle Assistant",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "debugger"
  ],
  "version": "2.1.54"
}